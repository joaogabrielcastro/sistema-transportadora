DATABASE_URL="postgresql://postgres:postgres@localhost:5434/transportadora_dev"
# disable | require | verify | auto (auto lê sslmode da URL)
DB_SSL_MODE="disable"
PRISMA_CLIENT_ENGINE_TYPE="library"
PORT=3020
NODE_ENV=development

# Segurança — em produção: AUTH_ENABLED=true e JWT_SECRET (≥16 chars) são obrigatórios
AUTH_ENABLED=false
JWT_SECRET=
# Limite de tentativas login/register por IP (janela 15 min; padrão 40)
# AUTH_RATE_LIMIT_MAX=40
# Opcional: token fixo para scripts/CI (não embutir no frontend)
API_TOKEN=
JWT_EXPIRES_IN=7d
# CORS_ORIGINS=https://abbroto.jwsoftware.com.br,http://localhost:5173

# Primeiro usuário admin do tenant seed (slug=abbroto), se esse tenant ainda não tiver usuários
# Vinculado ao tenant seed slug=abbroto
ADMIN_EMAIL=admin@abrotto.local
ADMIN_PASSWORD=admin123456
ADMIN_NOME=Administrador
# Opcional: forçar tenant padrão quando AUTH_ENABLED=false ou API_TOKEN
# DEFAULT_TENANT_ID=1

# Criar novo tenant + admin (CLI):
#   node scripts/create-tenant.mjs --slug=empresa --nome="Empresa" --email=admin@empresa.com --password=SenhaSegura123
# Cadastro público via /register (padrão: habilitado). Para desligar:
# ALLOW_PUBLIC_REGISTER=false
# E-mail do encarregado LGPD (opcional; o frontend usa VITE_LEGAL_CONTACT_EMAIL)
# LEGAL_CONTACT_EMAIL=privacidade@seudominio.com

# PDFs dos caminhões (upload) — em Docker/Coolify monte volume em /app/uploads
# UPLOADS_DIR=/app/uploads

# PDF (ordem de coleta) — opcional; vazio = Chrome do Puppeteer (recomendado no Docker)
# PUPPETEER_EXECUTABLE_PATH=
# Local sem Docker: npm run ensure-chrome

# SMTP — recuperação de senha, convite, ordem de coleta e digest
# Sem SMTP: "esqueci a senha" não envia e-mail (resposta continua genérica);
# convite por e-mail retorna 503 — use "criar com senha temporária" na tela de usuários.
# MAIL_FROM pode omitir se SMTP_USER já for o endereço de remetente.
#
# Opção A — transacional (Resend, Mailgun, Amazon SES, Postmark):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_...
# MAIL_FROM=ATrack <nao-responda@seudominio.com>
#
# Opção B — Microsoft 365 / Outlook:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@seudominio.com
# SMTP_PASS=   # senha da caixa OU senha de app (se tiver MFA)
# MAIL_FROM=noreply@seudominio.com
# Nunca commite a senha real — use só variáveis no Coolify ou .env local.
#
# Erro 535 / "SmtpClientAuthentication is disabled":
# No admin M365 → Usuários → caixa SMTP_USER → E-mail → Autenticação SMTP = habilitado
# https://aka.ms/smtp_auth_disabled

# Sentry (opcional) — DSN do projeto backend (Node)
# SENTRY_DSN=https://...@o....ingest.sentry.io/...

# Backup automático do Postgres (pg_dump gzip). Requer postgresql-client na imagem.
# BACKUP_ENABLED=true
# BACKUP_DIR=/app/backups
# BACKUP_RETENTION_DAYS=7
# BACKUP_HOUR_UTC=6
# BACKUP_ON_START=false
# BACKUP_S3_PREFIX=backups/
# Monte volume em /app/backups no Coolify. Se S3 estiver configurado, o dump também é enviado.

# Redis — fila durable de ordem de coleta (BullMQ). Sem isso, usa memória (dev/test).
# Em produção/Coolify: cole a URL interna do serviço Redis (mesma rede do container API).
# REDIS_URL=redis://default:SENHA@host-interno:6379/0
# Local opcional: docker compose up -d redis  →  redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# --- Billing / Stripe (somente tenants novos; legados ficam billing_exempt) ---
# URL pública do frontend: links de reset de senha, convite e retorno do Stripe.
# FRONTEND_URL=http://localhost:5173
# BILLING_TRIAL_DAYS=14
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Criar Products/Prices no Stripe com estes valores de referência (BRL/mês):
# STRIPE_PRICE_STARTER=price_...   # R$ 199 — frota básica
# STRIPE_PRICE_FISCAL=price_...    # R$ 499 — + NF-e e estoque
# STRIPE_PRICE_COMPLETE=price_...  # R$ 699 — pacote premium (frota + fiscal)
# (Ordem de coleta não é vendida — exclusiva do tenant ABroto)

# Worker PDF: por padrão roda na API. Só desligue se tiver processo separado:
# RUN_ORDEM_WORKER_IN_API=false
# npm run worker:ordem-coleta

# Object storage S3-compatível (AWS / Cloudflare R2 / MinIO) — opcional
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=          # ex.: https://xxx.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# WhatsApp (Meta Cloud API ou endpoint compatível)
# WHATSAPP_API_URL=https://graph.facebook.com/v19.0/PHONE_ID/messages
# WHATSAPP_TOKEN=
# WHATSAPP_FROM=

# Digest semanal: npm run job:weekly-digest

# Módulo fiscal de transporte (CT-e modelo 57 / MDF-e modelo 58 / CIOT).
# CT-e e MDF-e usam a Brasil NFe. Homologação e produção compartilham a mesma
# URL; o ambiente vai no payload (TipoAmbiente). Nunca coloque tokens no código.
# FISCAL_SECRETS_KEY=            # 64 hex (32 bytes) ou string livre; cifra Token/senha do certificado
# BRASIL_NFE_AMBIENTE=2          # 1 = produção, 2 = homologação (padrão)
# BRASIL_NFE_USER_TOKEN=         # UserToken da conta Brasil NFe (empresas/certificado A1)
# BRASIL_NFE_BASE_URL=https://api.brasilnfe.com.br/services
# FISCAL_AMBIENTE=homologacao    # legado: "producao" liga o ambiente 1
# FISCAL_CTE_MDFE_URL=           # legado: sobrescreve BRASIL_NFE_BASE_URL se esta estiver vazia
# FISCAL_CIOT_URL=               # base URL do provedor de CIOT (ANTT direta ou integrador)
# FISCAL_HTTP_TIMEOUT_MS=30000
# Retenções do comprovante de CIOT (item 3.3) — alíquota como fração (0.022 = 2,2%).
# Sem valor: nada é calculado nem gravado. Confirmar o percentual com o contador.
# FISCAL_CIOT_RETENCAO_INSS_ALIQUOTA=            # ex.: 0.022
# FISCAL_CIOT_RETENCAO_SEST_SENAT_ALIQUOTA=      # ex.: 0.005
