# URL da API (sem /api no final)
VITE_API_URL=https://api.seudominio.com.br

# Login é exigido por padrão. Só defina false para demo local com AUTH_ENABLED=false.
# VITE_AUTH_REQUIRED=false

# Cadastro público de empresas (alinhar com ALLOW_PUBLIC_REGISTER no backend)
# VITE_ALLOW_PUBLIC_REGISTER=false

# E-mail do encarregado / privacidade (exibido em /privacidade)
# VITE_LEGAL_CONTACT_EMAIL=privacidade@seudominio.com

# Sentry (opcional): DSN do projeto frontend. Sem isso, erros de UI só vão ao console.
# No Coolify, defina também como Build Argument (VITE_* entra no bundle no build).
# VITE_SENTRY_DSN=
