DATABASE_URL="postgresql://postgres:postgres@localhost:5434/transportadora_dev"
# disable | require | verify | auto (auto lê sslmode da URL)
DB_SSL_MODE="disable"
PRISMA_CLIENT_ENGINE_TYPE="library"
PORT=3020
NODE_ENV=development

# Segurança — em produção: AUTH_ENABLED=true e JWT_SECRET (≥16 chars) são obrigatórios
AUTH_ENABLED=false
JWT_SECRET=
# Limite de tentativas login/register por IP (janela 15 min; padrão 40)
# AUTH_RATE_LIMIT_MAX=40
# Opcional: token fixo para scripts/CI (não embutir no frontend)
API_TOKEN=
JWT_EXPIRES_IN=7d
# CORS_ORIGINS=https://abbroto.jwsoftware.com.br,http://localhost:5173

# Primeiro usuário admin do tenant seed (slug=abbroto), se esse tenant ainda não tiver usuários
# Vinculado ao tenant seed slug=abbroto
ADMIN_EMAIL=admin@abrotto.local
ADMIN_PASSWORD=admin123456
ADMIN_NOME=Administrador
# Opcional: forçar tenant padrão quando AUTH_ENABLED=false ou API_TOKEN
# DEFAULT_TENANT_ID=1

# Criar novo tenant + admin (CLI):
#   node scripts/create-tenant.mjs --slug=empresa --nome="Empresa" --email=admin@empresa.com --password=SenhaSegura123
# Cadastro público via /register (padrão: habilitado). Para desligar:
# ALLOW_PUBLIC_REGISTER=false

# PDFs dos caminhões (upload) — em Docker/Coolify monte volume em /app/uploads
# UPLOADS_DIR=/app/uploads

# PDF (ordem de coleta) — opcional; vazio = Chrome do Puppeteer (recomendado no Docker)
# PUPPETEER_EXECUTABLE_PATH=
# Local sem Docker: npm run ensure-chrome

# SMTP — envio de PDF (ordem de coleta / autorização)
# Microsoft 365 / Outlook (e-mail @abrottotransportes.com.br):
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=logistica@abrottotransportes.com.br
# SMTP_PASS=   # senha da caixa OU senha de app (se tiver MFA)
# MAIL_FROM=logistica@abrottotransportes.com.br
# Nunca commite a senha real — use só variáveis no Coolify ou .env local.
#
# Erro 535 / "SmtpClientAuthentication is disabled":
# No admin M365 → Usuários → caixa logistica@... → E-mail → Autenticação SMTP = habilitado
# https://aka.ms/smtp_auth_disabled

# Redis — fila durable de ordem de coleta (BullMQ). Sem isso, usa memória (dev/test).
# Em produção/Coolify: cole a URL interna do serviço Redis (mesma rede do container API).
# REDIS_URL=redis://default:SENHA@host-interno:6379/0
# Local opcional: docker compose up -d redis  →  redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# --- Billing / Stripe (somente tenants novos; legados ficam billing_exempt) ---
# FRONTEND_URL=http://localhost:5173
# BILLING_TRIAL_DAYS=14
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_OPS=price_...
# STRIPE_PRICE_FISCAL=price_...
# STRIPE_PRICE_COMPLETE=price_...

# Worker PDF separado em produção:
# RUN_ORDEM_WORKER_IN_API=false
# npm run worker:ordem-coleta

# Object storage S3-compatível (AWS / Cloudflare R2 / MinIO) — opcional
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=          # ex.: https://xxx.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# WhatsApp (Meta Cloud API ou endpoint compatível)
# WHATSAPP_API_URL=https://graph.facebook.com/v19.0/PHONE_ID/messages
# WHATSAPP_TOKEN=
# WHATSAPP_FROM=

# Digest semanal: npm run job:weekly-digest
